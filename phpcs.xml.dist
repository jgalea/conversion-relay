<?xml version="1.0"?>
<ruleset name="WP Conversion Hub">
	<description>Coding standards for WP Conversion Hub: WordPress security and best practices, without the docblock-on-everything rules.</description>

	<file>src</file>
	<file>wp-conversion-hub.php</file>
	<file>uninstall.php</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>

	<rule ref="WordPress-Extra">
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="conversion-relay"/>
			</property>
		</properties>
	</rule>
</ruleset>
